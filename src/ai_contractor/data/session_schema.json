{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Contractor++ session",
  "type": "object",
  "required": ["session_id", "project_id", "status", "provider", "interface", "created_at", "plan"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "complete", "halted"]},
    "provider": {"type": "string"},
    "interface": {"enum": ["cli", "web", "gui", "api"]},
    "created_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": ["string", "null"]},
    "plan": {"type": "string"},
    "evidence": {"type": ["object", "array", "string", "null"]}
  },
  "additionalProperties": true
}
